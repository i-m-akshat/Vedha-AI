# ==========================================
# ResuMate AI Platform Environment Config
# ==========================================

# --- General & App Settings ---
ENVIRONMENT=Development
APP_PORT=5000
FRONTEND_PORT=3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=resumate_admin
POSTGRES_PASSWORD=resumate_secret_password_change_me
POSTGRES_DB=resumate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=Host=postgres;Port=5432;Database=resumate_db;Username=resumate_admin;Password=resumate_secret_password_change_me;

# --- Caching (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis:6379

# --- Authentication & JWT ---
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_hs256
JWT_ISSUER=ResuMateApi
JWT_AUDIENCE=ResuMateClient
JWT_EXPIRY_MINUTES=1440

# --- OAuth Providers (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- AI Provider API Keys ---
# (User can also provide per-session API keys in Settings UI)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Default AI Model Settings ---
DEFAULT_AI_PROVIDER=Gemini
DEFAULT_AI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# --- Hangfire Dashboard ---
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=resumate_hangfire_admin_pass
