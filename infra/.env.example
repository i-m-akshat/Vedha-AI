# ==========================================
# Vedha AI Platform Environment Config
# ==========================================

# --- General & App Settings ---
ENVIRONMENT=Development
APP_PORT=5000
FRONTEND_PORT=3000
# Set to true to enable Swagger UI in Production containers (useful for staging)
ENABLE_SWAGGER=true

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=vedha_admin
POSTGRES_PASSWORD=vedha_secret_password_change_me
POSTGRES_DB=vedha_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=Host=postgres;Port=5432;Database=vedha_db;Username=vedha_admin;Password=vedha_secret_password_change_me;

# --- Caching (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis:6379

# --- Message Broker (NATS JetStream) ---
NATS_HOST=nats
NATS_PORT=4222
NATS_URL=nats://nats:4222

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vedha-resumes
MINIO_USE_SSL=false

# --- AI Playwright Worker & Proxies ---
AGENTQL_API_KEY=your_agentql_api_key_here
RESIDENTIAL_PROXY_URL=http://user:pass@proxy.example.com:8080

# --- Authentication & JWT ---
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_hs256
JWT_ISSUER=VedhaApi
JWT_AUDIENCE=VedhaClient
JWT_EXPIRY_MINUTES=1440

# --- OAuth Providers (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- AI Provider API Keys ---
# (User can also provide per-session API keys in Settings UI)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Default AI Model Settings ---
DEFAULT_AI_PROVIDER=Gemini
DEFAULT_AI_MODEL=gemini-flash-lite-latest
AI_MAX_TOKENS=16384
AI_TEMPERATURE=0.2

# --- Hangfire Dashboard ---
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=vedha_hangfire_admin_pass
